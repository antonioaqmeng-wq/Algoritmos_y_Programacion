Algoritmo Circuito3
	Definir p,q Como Logico
	
	p <- verdadero
	q <- Verdadero
	
	
	Escribir p,"    ",q,"   /    ",p o q, "       ", no (p o q), "            ", no (p o q) y (p o q)
	p <- Verdadero
	q <- Falso
	Escribir p,"    ",q,"   /      ",p o q, "       ", no (p o q), "            ", no (p o q) y (p o q)
	p <- Falso
	q <- Verdadero
	Escribir p,"    ",q,"   /    ",p o q, "       ", no (p o q), "            ", no (p o q) y (p o q)
	q <- Falso
	p <- Falso
	Escribir p,"    ",q,"   /    ",p o q, "        ", no (p o q), "            ", no (p o q) y (p o q)
	
	
FinAlgoritmo
