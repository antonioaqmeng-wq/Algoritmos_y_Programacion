//Suma de numeros pares entre 2 y 100

Algoritmo Ejercicio4
	Definir suma,num Como Entero
	
	suma <- 2
	num <- 4
	
	Repetir
		suma <- suma + num
		num <- num +2
	Mientras Que num <= 100
	
	Escribir "La suma entre 2 y 100 es: ", suma
	
FinAlgoritmo
